<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.schoolcopilot</groupId>
	<artifactId>content-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<!--
		Un module par cycle scolaire.

		Ce n'est pas de la decoration : Maven refuse a la compilation qu'un module
		en importe un autre sans l'avoir declare. Le lycee ne peut donc pas se
		mettre a dependre de la prepa par inadvertance, et content-earlyyears reste
		extractible vers une application separee le jour venu.

		Ordre volontaire : content-core d'abord, content-app en dernier puisqu'il
		assemble tout le reste.
	-->
	<modules>
		<module>content-core</module>
		<module>content-earlyyears</module>
		<module>content-college</module>
		<module>content-highschool</module>
		<module>content-prepa</module>
		<module>content-university</module>
		<module>content-app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-earlyyears</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-college</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-highschool</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-prepa</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.schoolcopilot</groupId>
				<artifactId>content-university</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Outillage de test commun a tous les modules. -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
