<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.schoolcopilot</groupId>
		<artifactId>content-service</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>content-app</artifactId>

	<!--
		Le seul module executable. Il assemble les cycles et porte ce qui est
		transverse : securite, gestion des erreurs, configuration.

		C'est aussi le seul endroit ou la liste des cycles apparait. Retirer un
		cycle de l'application revient a retirer une ligne ici.
	-->
	<dependencies>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-earlyyears</artifactId>
		</dependency>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-college</artifactId>
		</dependency>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-highschool</artifactId>
		</dependency>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-prepa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.schoolcopilot</groupId>
			<artifactId>content-university</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Valide les access tokens emis par l'auth-service, sans jamais l'appeler. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
