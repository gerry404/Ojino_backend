# Copie ce fichier en .env et remplis-le. Le .env n'est PAS versionne.
#
#   cp .env.example .env
#
# Toutes ces variables ont une valeur par defaut de developpement dans le
# docker-compose.yml. Elles sont donc facultatives sur ton poste, et
# OBLIGATOIRES sur le serveur : les defauts sont publics, ils sont dans Git.

# -----------------------------------------------------------------------------
# Secrets — a regenerer pour la production
# -----------------------------------------------------------------------------

# Signe et valide tous les access tokens. Le meme pour les dix services : c'est
# ce partage qui leur permet de valider un token sans appeler l'auth-service.
# Au moins 32 caracteres, sinon les services refusent de demarrer.
#   openssl rand -base64 48
OJINO_JWT_SECRET=

# Protege les routes de service a service, celles qui n'ont pas d'utilisateur
# derriere elles (assistant -> ai, engagement -> notification).
#   openssl rand -base64 32
OJINO_INTERNAL_TOKEN=

# Signe les URL de medias temporaires.
#   openssl rand -base64 32
OJINO_MEDIA_SECRET=

# -----------------------------------------------------------------------------
# Base de donnees
# -----------------------------------------------------------------------------

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
# Mot de passe commun aux dix utilisateurs applicatifs. Il n'est lu qu'au tout
# premier demarrage, quand le volume est vide : le changer ensuite impose un
# docker compose down -v, qui efface les donnees.
OJINO_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Passerelle
# -----------------------------------------------------------------------------

# Vide ou ":80" : Caddy sert en clair, sans certificat. Un nom de domaine, et il
# obtient puis renouvelle le certificat tout seul.
OJINO_DOMAIN=
ACME_EMAIL=
# Sert a construire les URL publiques de medias.
OJINO_PUBLIC_URL=http://localhost

# L'application Angular. En developpement elle tourne hors conteneur, d'ou
# host.docker.internal. Une fois conteneurisee : ojino-web:4000
WEB_UPSTREAM=host.docker.internal:4200

# realtime-service vit dans un autre depot, il n'est pas encore conteneurise.
REALTIME_UPSTREAM=host.docker.internal:8090

# -----------------------------------------------------------------------------
# Options par service
# -----------------------------------------------------------------------------

# Comptes promus administrateur au demarrage, separes par des virgules.
OJINO_ADMIN_EMAILS=

# Connexion sociale. Laisse vide tant que tu ne l'as pas configuree.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# "canned" = reponses factices. "remote" = le vrai moteur, qui exige que
# ai-service tourne et soit joignable a AI_SERVICE_URL.
AI_ENGINE=canned
AI_SERVICE_URL=http://ai-service:8091

# La FAQ est-elle lisible sans etre connecte.
SUPPORT_FAQ_PUBLIC=false

# local ou s3.
MEDIA_STORAGE=local

TZ=Africa/Douala
