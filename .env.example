# Copier en .env et ajuster. Le fichier .env n'est jamais commite.
#
#   cp .env.example .env
#   docker compose up -d

# --- MongoDB (lu par docker-compose) ---------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=ojino_root_dev
# Mot de passe partage par les trois utilisateurs de service.
OJINO_DB_PASSWORD=ojino_dev_password

# --- Services ---------------------------------------------------------------
# Doit etre identique pour les trois services : c'est ce partage qui permet a
# user-service et content-service de valider un token sans appeler l'auth.
# En production : au moins 32 caracteres, genere aleatoirement.
OJINO_JWT_SECRET=dev-secret-a-remplacer-absolument-en-production-32+

# Comptes recevant le role ADMIN a la connexion, separes par des virgules.
OJINO_ADMIN_EMAILS=

# --- Connexions sociales ----------------------------------------------------
# Un client ID par plateforme (web, iOS, Android), separes par des virgules.
# Tant que la liste est vide, le provider refuse poliment les connexions.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
